{
  "$schema": "https://raw.githubusercontent.com/cloudflare/workers-sdk/main/packages/wrangler/config-schema.json",
  "name": "lead-database-manager",
  "main": "./src/worker.js",
  "compatibility_date": "2026-11-12",
  "workers_dev": true,
  "keep_vars": true,
  "assets": {
    "directory": "./public/",
    "binding": "ASSETS",
    "run_worker_first": [
      "/api/*"
    ]
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "lead-database-manager-db"
    }
  ],
  "observability": {
    "enabled": true
  },
  "compatibility_flags": [
    "nodejs_compat"
  ],
  "durable_objects": {
    "bindings": [
      {
        "name": "TELEGRAM_SESSION",
        "class_name": "TelegramSession"
      }
    ]
  },
  "migrations": [
    {
      "tag": "v1-mtproto-session",
      "new_sqlite_classes": [
        "TelegramSession"
      ]
    }
  ]
}
